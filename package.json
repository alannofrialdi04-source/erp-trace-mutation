{
  "name": "erp-trace-mutation",
  "version": "0.2.0",
  "private": true,
  "description": "Toolkit mongosh (read-only) untuk menelusuri mutasi stok ERP Kawasan Berikat / IT Inventory",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "cek:dist": "node scripts/build.js --check",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integrasi": "node --test --test-concurrency=1 \"test/integrasi/*.test.js\"",
    "test:semua": "npm test && npm run test:integrasi",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v"
  }
}
